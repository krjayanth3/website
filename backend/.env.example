DJANGO_SETTINGS_MODULE=backend.settings.development
SECRET_KEY=replace-this-with-a-strong-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
TIME_ZONE=UTC

# Development PostgreSQL database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=abcx_website
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
# Optional single-string alternative, useful for Supabase/hosted Postgres.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/abcx_website

# Optional production extras
# DJANGO_SETTINGS_MODULE=backend.settings.production
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# DB_SSLMODE=require

# Consultation requests are always saved in the dashboard.
# Enable alerts only after configuring your email provider.
CONSULTATION_EMAIL_ENABLED=False
CONSULTATION_NOTIFICATION_EMAIL=directors@abcx.co.in
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=directors@abcx.co.in
